# =============================================================================
# .gitattributes — Cross-platform (Windows / macOS / Linux)
# Best Practice / Production-ready / Enterprise-grade
# =============================================================================
# Goals:
# 1. Consistent line endings across all platforms
# 2. Correct binary handling (no corruption)
# 3. Better diffs & merges
# 4. GitHub Linguist support
# 5. Safe archive exports
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Default behavior
# -----------------------------------------------------------------------------
# Auto-detect text files and normalize line endings to LF in the repository.
# On checkout, Git will convert to the platform's native line ending (CRLF on Windows).
* text=auto eol=lf


# -----------------------------------------------------------------------------
# 2. Explicit text files (force LF)
# -----------------------------------------------------------------------------
*.md            text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.xml           text eol=lf
*.html          text eol=lf
*.htm           text eol=lf
*.css           text eol=lf
*.scss          text eol=lf
*.sass          text eol=lf
*.less          text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.py            text eol=lf
*.rb            text eol=lf
*.php           text eol=lf
*.java          text eol=lf
*.kt            text eol=lf
*.kts           text eol=lf
*.go            text eol=lf
*.rs            text eol=lf
*.c             text eol=lf
*.cpp           text eol=lf
*.cc            text eol=lf
*.h             text eol=lf
*.hpp           text eol=lf
*.cs            text eol=lf
*.swift         text eol=lf
*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf
*.fish          text eol=lf
*.ps1           text eol=lf
*.sql           text eol=lf
*.graphql       text eol=lf
*.gql           text eol=lf
*.vue           text eol=lf
*.svelte        text eol=lf
*.astro         text eol=lf
*.lock          text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf
*.editorconfig  text eol=lf
*.env           text eol=lf
*.env.*         text eol=lf
Dockerfile      text eol=lf
docker-compose*.yml text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
*.cmake         text eol=lf
CMakeLists.txt  text eol=lf
*.gradle        text eol=lf
*.properties    text eol=lf
*.ini           text eol=lf
*.cfg           text eol=lf
*.conf          text eol=lf
*.svg           text eol=lf
*.csv           text eol=lf
*.tsv           text eol=lf


# -----------------------------------------------------------------------------
# 3. Windows-specific scripts (keep CRLF)
# -----------------------------------------------------------------------------
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.vbs           text eol=crlf


# -----------------------------------------------------------------------------
# 4. Binary files (NEVER treat as text)
# -----------------------------------------------------------------------------
# Images
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.bmp           binary
*.tif           binary
*.tiff          binary
*.psd           binary
*.ai            binary
*.eps           binary

# Audio / Video
*.mp3           binary
*.mp4           binary
*.wav           binary
*.ogg           binary
*.flac          binary
*.avi           binary
*.mov           binary
*.mkv           binary
*.webm          binary

# Archives & compressed
*.zip           binary
*.tar           binary
*.gz            binary
*.tgz           binary
*.bz2           binary
*.xz            binary
*.7z            binary
*.rar           binary

# Documents
*.pdf           binary
*.doc           binary
*.docx          binary
*.xls           binary
*.xlsx          binary
*.ppt           binary
*.pptx          binary
*.odt           binary
*.ods           binary
*.odp           binary

# Fonts
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.eot           binary

# Compiled / packages
*.exe           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.a             binary
*.lib           binary
*.o             binary
*.obj           binary
*.class         binary
*.jar           binary
*.war           binary
*.ear           binary
*.pyc           binary
*.pyo           binary
*.pyd           binary
*.whl           binary
*.egg           binary
*.node          binary
*.wasm          binary

# Databases & data
*.db            binary
*.sqlite        binary
*.sqlite3       binary
*.mdb           binary

# Design / other
*.sketch        binary
*.fig           binary
*.xd            binary
*.blend         binary
*.fbx           binary
*.glb           binary
*.gltf          binary


# -----------------------------------------------------------------------------
# 5. Better diffs
# -----------------------------------------------------------------------------
*.md            diff=markdown
*.py            diff=python
*.rb            diff=ruby
*.php           diff=php
*.java          diff=java
*.cs            diff=csharp
*.html          diff=html
*.css           diff=css
*.js            diff=javascript
*.ts            diff=javascript
*.jsx           diff=javascript
*.tsx           diff=javascript
*.json          diff=json
*.yml           diff=yaml
*.yaml          diff=yaml
*.go            diff=golang
*.rs            diff=rust
*.c             diff=cpp
*.cpp           diff=cpp
*.h             diff=cpp
*.hpp           diff=cpp


# -----------------------------------------------------------------------------
# 6. Merge strategy (optional but recommended)
# -----------------------------------------------------------------------------
# Keep lock files from causing merge conflicts
package-lock.json   merge=binary
yarn.lock           merge=binary
pnpm-lock.yaml      merge=binary
composer.lock       merge=binary
Pipfile.lock        merge=binary
poetry.lock         merge=binary
Cargo.lock          merge=binary
go.sum              merge=binary
Gemfile.lock        merge=binary


# -----------------------------------------------------------------------------
# 7. GitHub Linguist (language statistics & documentation)
# -----------------------------------------------------------------------------
# Documentation
docs/**         linguist-documentation
*.md            linguist-documentation
*.rst           linguist-documentation
*.txt           linguist-documentation

# Generated / vendored code
dist/**         linguist-generated
build/**        linguist-generated
out/**          linguist-generated
vendor/**       linguist-vendored
third_party/**  linguist-vendored
node_modules/** linguist-vendored


# -----------------------------------------------------------------------------
# 8. Export-ignore (for git archive)
# -----------------------------------------------------------------------------
.gitattributes  export-ignore
.gitignore      export-ignore
.github/        export-ignore
.vscode/        export-ignore
.idea/          export-ignore
*.md            export-ignore
docs/           export-ignore
tests/          export-ignore
test/           export-ignore
__tests__/      export-ignore
.spec.ts        export-ignore
.spec.js        export-ignore
.travis.yml     export-ignore
.circleci/      export-ignore
.gitlab-ci.yml  export-ignore
.editorconfig   export-ignore
.eslintrc*      export-ignore
.prettierrc*    export-ignore
tsconfig*.json  export-ignore
